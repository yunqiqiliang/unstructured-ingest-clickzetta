      "instance": "your_instance",
      "workspace": "default",
      "schema": "default",
      "vcluster": "default",
      "is_default": true
    },
    {
      "connection_name": "staging",
      "service": "https://staging-api.clickzetta.com",
      "username": "test_user",
      "password": "test_password",
      "instance": "test_instance",
      "workspace": "test",
      "schema": "test",
      "vcluster": "test_cluster"
    }
  ]
}